{
  "name": "SQL-Console",
  "description": "Check a BigQuery result and send it to a Sheet or Doc, without creating an OWOX report. Import SQL from a data mart or the query a report will run, edit it here, and write a data mart's SQL back. Save the SQL, compare versions, or refresh a sheet daily or weekly even while SQL-Console is closed. An AI assistant rewrites, explains, or fixes the SQL in a chat next to the editor when an Anthropic Credential is selected; each question sends the SQL, the query note, the reachable table and field names, and a small sample of the last result to Claude.",
  "collections": [
    {
      "name": "queries",
      "scope": "member"
    },
    {
      "name": "preferences",
      "scope": "member"
    },
    {
      "name": "chats",
      "scope": "member"
    }
  ],
  "delivery": {
    "type": "remote",
    "url": "https://romandubovyi.github.io/sql-console/"
  },
  "backend": {
    "url": "https://sql-console.r-dubovoi.workers.dev",
    "actions": {
      "export-sheet": {
        "timeoutSeconds": 300,
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queryId"],
          "properties": {
            "queryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "ai-chat": {
        "timeoutSeconds": 180,
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sql", "messages"],
          "properties": {
            "sql": {
              "type": "string",
              "maxLength": 100000
            },
            "description": {
              "type": "string",
              "maxLength": 2500
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns"],
              "properties": {
                "columns": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "rows": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                },
                "totalRows": {
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "fields": {
                    "type": "array",
                    "maxItems": 150,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name"],
                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 300
                        },
                        "type": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 1000
                        }
                      }
                    }
                  }
                }
              }
            },
            "messages": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "content"],
                "properties": {
                  "role": {
                    "enum": ["user", "assistant"]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 30000
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "credentials": [
    {
      "id": "google-service-account",
      "scopes": [
        "https://www.googleapis.com/auth/bigquery.readonly",
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/documents",
        "https://www.googleapis.com/auth/drive.metadata.readonly"
      ]
    },
    {
      "id": "anthropic",
      "optional": true
    }
  ]
}
