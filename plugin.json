{
  "name": "SQL-Console",
  "description": "Run a read-only BigQuery query with the plugin Credential, keep saved queries, and export a preview page to a Google Sheet or Doc.",
  "collections": [
    {
      "name": "queries",
      "scope": "member"
    },
    {
      "name": "preferences",
      "scope": "member"
    }
  ],
  "delivery": {
    "type": "remote",
    "url": "https://romandubovyi.github.io/sql-console/"
  },
  "credentials": [
    {
      "id": "google-service-account",
      "scopes": [
        "https://www.googleapis.com/auth/bigquery.readonly",
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/documents",
        "https://www.googleapis.com/auth/drive.metadata.readonly"
      ]
    }
  ]
}
