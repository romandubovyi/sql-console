{
  "name": "SQL-Console",
  "description": "Run a read-only BigQuery query with the plugin Credential, and keep saved queries.",
  "collections": [
    {
      "name": "queries",
      "scope": "member"
    },
    {
      "name": "preferences",
      "scope": "member"
    }
  ],
  "delivery": {
    "type": "remote",
    "url": "https://romandubovyi.github.io/sql-console/"
  },
  "credentials": [
    {
      "id": "google-service-account",
      "scopes": ["https://www.googleapis.com/auth/bigquery.readonly"]
    }
  ]
}
