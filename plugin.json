{
  "name": "SQL-Console",
  "description": "Check a BigQuery result and send it to a Sheet or Doc, without creating an OWOX report. Save the SQL, compare versions, or refresh that sheet daily or weekly even while SQL-Console is closed. When the answer belongs in OWOX, turn the same query into a SQL data mart.",
  "collections": [
    {
      "name": "queries",
      "scope": "member"
    },
    {
      "name": "preferences",
      "scope": "member"
    }
  ],
  "delivery": {
    "type": "remote",
    "url": "https://romandubovyi.github.io/sql-console/"
  },
  "backend": {
    "url": "https://sql-console.r-dubovoi.workers.dev",
    "actions": {
      "export-sheet": {
        "timeoutSeconds": 300,
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queryId"],
          "properties": {
            "queryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  },
  "credentials": [
    {
      "id": "google-service-account",
      "scopes": [
        "https://www.googleapis.com/auth/bigquery.readonly",
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/documents",
        "https://www.googleapis.com/auth/drive.metadata.readonly"
      ]
    }
  ]
}
